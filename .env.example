# in production, e.g. https://phmedia.se — drives canonical tags, sitemap,
# robots and JSON-LD. Leave empty in preview/dev to fall back to the preview URL.
NEXT_PUBLIC_SITE_URL=""
# Private
SANITY_VIEWER_TOKEN=""

