# Copy to .env.local and fill in. Mirrors the structure of .env.local:
# one active .Localhost block, plus commented .Qa / .Production references.

# ─────────────────────────────────────────────────────────────
# .Localhost (active)
# ─────────────────────────────────────────────────────────────

# Sanity — public
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET=""
NEXT_PUBLIC_SANITY_API_VERSION=""
NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL=""
# Sanity — private
SANITY_VIEWER_TOKEN=""
SANITY_WRITE_TOKEN=""

# Site — canonical public URL, no trailing slash. Empty falls back to preview URL.
NEXT_PUBLIC_SITE_URL=""

# Stripe (test mode — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
# Webhook signing secret. Locally, printed by:
#   stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=""

# Cron / stock reconcile
# Bearer secret guarding /api/tickets/reconcile & /api/products/reconcile.
# Optional locally; set in Vercel so the nightly reconcile cron can authorize.
CRON_SECRET=""


# ─────────────────────────────────────────────────────────────
# .Qa (reference — copy into Vercel "Preview" env)
# ─────────────────────────────────────────────────────────────
# # Sanity — public
# NEXT_PUBLIC_SANITY_PROJECT_ID=""
# NEXT_PUBLIC_SANITY_DATASET=""
# NEXT_PUBLIC_SANITY_API_VERSION=""
# NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL=""
# # Sanity — private
# SANITY_VIEWER_TOKEN=""
# SANITY_WRITE_TOKEN=""
# # Site
# NEXT_PUBLIC_SITE_URL=""
# # Stripe (test mode)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# # Cron / stock reconcile
# CRON_SECRET=""


# ─────────────────────────────────────────────────────────────
# .Production (reference — copy into Vercel "Production" env)
# ─────────────────────────────────────────────────────────────
# # Sanity — public
# NEXT_PUBLIC_SANITY_PROJECT_ID=""
# NEXT_PUBLIC_SANITY_DATASET=""
# NEXT_PUBLIC_SANITY_API_VERSION=""
# NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL=""
# # Sanity — private
# SANITY_VIEWER_TOKEN=""
# SANITY_WRITE_TOKEN=""
# # Site
# NEXT_PUBLIC_SITE_URL=""
# # Stripe (LIVE mode — https://dashboard.stripe.com/apikeys)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# # Cron / stock reconcile
# CRON_SECRET=""
